# Compiles the sensor's CO-RE eBPF programs. The reasoning behind every pin and
# flag here is in docs/adr/0001-ebpf-toolchain.md.
#
#   make -C sensor/bpf           compile each *.bpf.c to build/*.bpf.o
#   make -C sensor/bpf vmlinux   regenerate vmlinux.h from the running kernel
#   make -C sensor/bpf clean     remove build/
#
# clang and bpftool are pinned in mise.toml, and cilium/ebpf in sensor/go.mod.
# libbpf is only a set of headers, not a tool or a Go module, so it is pinned here.

SHELL := /usr/bin/env bash

LIBBPF_VERSION := 1.8.0
LIBBPF_SHA256  := b7a1e685f90f6a63ead0dd85d053694b222975da8d09c1a966041cff6f0055ff

# Instruction set. Fixed so the kernel floor never moves with a clang upgrade.
BPF_CPU := v3

# The clang pin has one home: this reads it from mise.toml.
MISE_TOML := ../../mise.toml
CLANG_PIN := $(shell sed -n 's/^"conda:clang-[0-9]*"[[:space:]]*=[[:space:]]*"\([0-9.]*\)".*/\1/p' $(MISE_TOML))
ifeq ($(CLANG_PIN),)
$(error no conda:clang-<major> entry in $(MISE_TOML))
endif

CLANG   ?= clang-$(firstword $(subst ., ,$(CLANG_PIN)))
BPFTOOL ?= bpftool

LIBBPF_DIR     := build/libbpf-$(LIBBPF_VERSION)
LIBBPF_ARCHIVE := $(LIBBPF_DIR).tar.gz
LIBBPF_HEADERS := $(LIBBPF_DIR)/bpf/.verified

# -g                 BTF and CO-RE relocations come from debug info.
# -fms-extensions    vmlinux.h from recent kernels has anonymous tagged members.
#                    Without this flag clang warns and drops them.
# -ffile-prefix-map  keeps the checkout path out of the object, so output does
#                    not depend on where the repo is cloned.
BPF_CFLAGS := -target bpf -mcpu=$(BPF_CPU) -O2 -g \
	-D__TARGET_ARCH_x86 \
	-Wall -Werror \
	-fms-extensions -Wno-microsoft-anon-tag \
	-ffile-prefix-map=$(CURDIR)=. \
	-I. -I$(LIBBPF_DIR)

SRCS    := $(wildcard *.bpf.c)
OBJS    := $(SRCS:%.bpf.c=build/%.bpf.o)
HEADERS := $(wildcard *.h)

.DELETE_ON_ERROR:
.PHONY: all check-clang vmlinux clean

all: $(OBJS)

build/%.bpf.o: %.bpf.c $(HEADERS) $(LIBBPF_HEADERS) | check-clang
	$(CLANG) $(BPF_CFLAGS) -c $< -o $@

# A different clang still produces a working object, just not the pinned one.
check-clang:
	@version="$$($(CLANG) -dumpversion 2>/dev/null)" || { \
		echo "error: $(CLANG) not found (run: mise install)" >&2; exit 1; }; \
	case "$$version" in \
	$(CLANG_PIN).*) ;; \
	*) echo "error: $(CLANG) is $$version, mise.toml pins $(CLANG_PIN)" >&2; exit 1 ;; \
	esac

# One shell, so the trap covers every step. The archive is only needed here, and
# the marker is written last, so its absence means this run did not finish.
$(LIBBPF_HEADERS):
	@set -e; \
	trap 'rm -f $(LIBBPF_ARCHIVE); [ -e $@ ] || { rm -rf $(LIBBPF_DIR); rmdir --ignore-fail-on-non-empty build; }' EXIT; \
	mkdir -p $(@D); \
	curl -fsSL -o $(LIBBPF_ARCHIVE) \
		https://github.com/libbpf/libbpf/archive/refs/tags/v$(LIBBPF_VERSION).tar.gz; \
	echo "$(LIBBPF_SHA256)  $(LIBBPF_ARCHIVE)" | sha256sum --check --quiet -; \
	tar -xzf $(LIBBPF_ARCHIVE) -C $(@D) --strip-components=2 \
		--wildcards 'libbpf-$(LIBBPF_VERSION)/src/bpf_*.h'; \
	touch $@

# Run by hand and commit the result. It is deliberately not a build step: the
# output depends on the kernel of the machine that runs it. A failed run leaves
# the existing vmlinux.h untouched and no temporary file behind.
vmlinux:
	@trap 'rm -f vmlinux.h.tmp' EXIT; \
	{ \
		printf '/* Generated by make -C sensor/bpf vmlinux. Do not edit.\n'; \
		printf ' * Source: BTF of Linux %s %s\n */\n' "$$(uname -r)" "$$(uname -m)"; \
		$(BPFTOOL) btf dump file /sys/kernel/btf/vmlinux format c; \
	} > vmlinux.h.tmp && mv vmlinux.h.tmp vmlinux.h

clean:
	rm -rf build
